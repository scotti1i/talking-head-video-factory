{
  "name": "talking-head-video-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-format talking-head workflow with semantic editing, visual components, captions, QA, and delivery.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:editing && npm run test:visual-stage && npm run test:visual-plan && npm run test:color && npm run test:visual-compile && npm run test:workflow && npm run test:visual-recipes && npm run test:visual-route",
    "doctor": "node scripts/doctor.mjs",
    "new": "node scripts/new-job.mjs",
    "inventory": "node scripts/inventory-media.mjs",
    "transcribe:editor": "node scripts/transcribe-editor.mjs",
    "transcript:audit": "node scripts/audit-editor-transcript.mjs",
    "editorial:check": "node scripts/qa-editorial-contract.mjs --stage plan",
    "editorial:approve": "node scripts/approve-editorial-plan.mjs",
    "editorial:migrate": "node scripts/bootstrap-editorial-contract.mjs",
    "captions:build": "node scripts/captions-from-edl.mjs",
    "captions:srt": "node scripts/captions-to-srt.mjs",
    "status": "node scripts/factory-status.mjs",
    "status:all": "node scripts/workflow-audit.mjs",
    "regression:editorial": "node scripts/check-editorial-baselines.mjs",
    "storage:report": "node scripts/storage-report.mjs",
    "storage:plan": "node scripts/storage-report.mjs --plan",
    "audio:normalize": "node scripts/normalize-audio.mjs",
    "audio:qa": "node scripts/qa-audio.mjs",
    "legacy:roughcut:silence": "node scripts/create-rough-cut-edl.mjs",
    "legacy:roughcut:apply": "node scripts/apply-rough-cut-cuts.mjs",
    "roughcut:render": "node scripts/render-rough-cut-edl.mjs",
    "qa:cuts": "node scripts/qa-cuts.mjs",
    "qa:cuts:approve": "node scripts/approve-cut-qa.mjs",
    "visual:check": "node scripts/qa-editorial-contract.mjs --stage visual",
    "visual:recipes": "node scripts/visual-recipes.mjs",
    "visual:recipes:sync": "node scripts/visual-recipes.mjs sync",
    "visual:vendor:sync": "node scripts/vendor-shotcraft.mjs sync",
    "visual:vendor:verify": "node scripts/vendor-shotcraft.mjs verify",
    "visual:context": "node scripts/visual-context.mjs",
    "visual:plan:init": "node scripts/visual-plan-init.mjs",
    "visual:plan:check": "node scripts/visual-plan-contract.mjs",
    "visual:route": "node scripts/visual-scene-router.mjs",
    "visual:stage": "node scripts/narrative-stage-plan.mjs",
    "visual:prepare": "node scripts/visual-plan-compile.mjs prepare",
    "visual:render": "node scripts/render-visual-recipes.mjs",
    "visual:qa": "node scripts/visual-recipe-qa.mjs build",
    "visual:qa:approve": "node scripts/visual-recipe-qa.mjs approve",
    "visual:qa:check": "node scripts/visual-recipe-qa.mjs check",
    "visual:compile": "node scripts/visual-plan-compile.mjs finalize",
    "test:visual-recipes": "node --test scripts/visual-recipe-registry.test.mjs",
    "test:visual-vendor": "node --test scripts/vendor-shotcraft.test.mjs scripts/shotcraft-direct-port.test.mjs",
    "test:visual-plan": "node --test scripts/visual-plan-contract.test.mjs scripts/visual-plan-init.test.mjs scripts/visual-workflow-e2e.test.mjs",
    "test:visual-route": "node --test scripts/visual-scene-router.test.mjs",
    "test:visual-stage": "node --test scripts/narrative-stage-plan.test.mjs",
    "test:visual-compile": "node --test scripts/visual-plan-compile.test.mjs scripts/visual-recipe-qa.test.mjs",
    "build": "node scripts/build-beats-composition.mjs",
    "build:beats": "node scripts/build-beats-composition.mjs",
    "console": "node console/server.mjs",
    "visual:previews": "node scripts/visual-preview-generate.mjs",
    "test:color": "node --test scripts/color-management.test.mjs scripts/video-geometry.test.mjs",
    "test:visual-library": "node --test console/jobs.test.mjs console/color-system.test.mjs scripts/component-registry.test.mjs scripts/visual-preview-lib.test.mjs visual-assets/catalog.test.mjs",
    "test:workflow": "node --test console/runner.test.mjs console/prompts.test.mjs scripts/workflow-profile.test.mjs scripts/workflow-status.test.mjs scripts/editorial-workflow.test.mjs scripts/storage-report.test.mjs scripts/music-bed.test.mjs",
    "test:editing": "node --test scripts/cut-boundary-policy.test.mjs scripts/cut-listening-review.test.mjs scripts/semantic-take-map.test.mjs scripts/editorial-contract.test.mjs scripts/bootstrap-editorial-contract.test.mjs scripts/approve-cut-qa.test.mjs scripts/approve-final-qa.test.mjs",
    "sample": "node scripts/create-sample-job.mjs",
    "transcribe": "node scripts/transcribe-editor.mjs",
    "app": "bash scripts/make-app.sh",
    "build:variants": "node scripts/build-variants.mjs",
    "check:variants": "node scripts/check-variants.mjs",
    "render:variants": "node scripts/render-variants.mjs",
    "qa:variants": "node scripts/qa-variants.mjs",
    "deliver:variants": "node scripts/deliver-variants.mjs",
    "cut:shorts": "node scripts/cut-shorts.mjs",
    "lint": "hyperframes lint",
    "validate": "hyperframes validate",
    "inspect": "hyperframes inspect --samples 20",
    "check": "npm run lint && npm run validate && npm run inspect",
    "render:review": "hyperframes render --fps 30 --quality standard --workers 4 --video-bitrate 24M --output renders/review-30fps.mp4",
    "render:final": "hyperframes render --fps 60 --quality high --workers 8 --video-bitrate 36M --output renders/final-60fps.mp4",
    "qa": "node scripts/qa-final.mjs",
    "qa:final:approve": "node scripts/approve-final-qa.mjs",
    "deliver": "node scripts/deliver.mjs",
    "smoke": "node scripts/create-smoke-job.mjs && node scripts/build-beats-composition.mjs --job jobs/smoke && cd jobs/smoke && npm run check",
    "smoke:full": "npm run smoke && cd jobs/smoke && npm run render:final && cd ../.. && npm run qa -- --job jobs/smoke --video jobs/smoke/renders/final-60fps.mp4 && npm run deliver -- --job jobs/smoke --video jobs/smoke/renders/final-60fps.mp4",
    "smoke:multi": "node scripts/create-smoke-job.mjs && npm run build:variants -- --job jobs/smoke && npm run check:variants -- --job jobs/smoke",
    "stage:review": "node scripts/stage-review.mjs",
    "stage:approve": "node scripts/stage-approve.mjs",
    "stage:regress": "node scripts/stage-regress.mjs"
  },
  "dependencies": {
    "hyperframes": "0.5.6"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scotti1i/talking-head-video-factory.git"
  }
}
