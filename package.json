{
  "name": "talking-head-video-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-format talking-head workflow with semantic editing, visual components, captions, QA, and delivery.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "doctor:deployment": "node scripts/deployment-doctor.mjs",
    "audit:public": "node scripts/public-release-policy.mjs",
    "deploy:bundle": "node scripts/build-windows-bundle.mjs",
    "migrate": "node scripts/run-with-beacon.mjs scripts/migrate-jobs.mjs",
    "update": "node scripts/run-with-beacon.mjs --ok-exit 3 scripts/factory-update.mjs",
    "request": "node scripts/request.mjs",
    "report:push": "node scripts/report-push.mjs",
    "acceptance": "node scripts/run-with-beacon.mjs scripts/acceptance.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "new": "node scripts/new-job.mjs",
    "intake": "node scripts/intake-job.mjs",
    "test:contracts": "node --test scripts/product-contracts.test.mjs",
    "review": "node scripts/run-with-beacon.mjs scripts/review-feedback.mjs",
    "inventory": "node scripts/run-with-beacon.mjs scripts/inventory-media.mjs",
    "transcribe:editor": "node scripts/run-with-beacon.mjs scripts/transcribe-editor.mjs",
    "transcript:audit": "node scripts/run-with-beacon.mjs scripts/audit-editor-transcript.mjs",
    "captions:build": "node scripts/run-with-beacon.mjs scripts/captions-from-aroll.mjs",
    "captions:voice-qa": "node scripts/run-with-beacon.mjs scripts/qa-caption-voice.mjs",
    "dialogue:qa": "node scripts/run-with-beacon.mjs scripts/qa-dialogue-continuity.mjs",
    "status": "node scripts/factory-status.mjs",
    "status:all": "node scripts/workflow-audit.mjs",
    "storage:report": "node scripts/storage-report.mjs",
    "storage:plan": "node scripts/storage-report.mjs --plan",
    "audio:normalize": "node scripts/normalize-audio.mjs",
    "video:tag-sdr": "node scripts/tag-sdr-rec709.mjs",
    "audio:qa": "node scripts/qa-audio.mjs",
    "legacy:roughcut:silence": "node scripts/create-rough-cut-edl.mjs",
    "legacy:roughcut:apply": "node scripts/apply-rough-cut-cuts.mjs",
    "roughcut:render": "node scripts/run-with-beacon.mjs scripts/render-rough-cut-edl.mjs",
    "aroll:beauty": "node scripts/render-aroll-beauty.mjs",
    "qa:cuts": "node scripts/run-with-beacon.mjs scripts/qa-cuts.mjs",
    "qa:cuts:approve": "node scripts/approve-cut-qa.mjs",
    "build": "node scripts/build-beats-composition.mjs",
    "build:beats": "node scripts/build-beats-composition.mjs",
    "console": "node console/server.mjs",
    "visual:previews": "node scripts/visual-preview-generate.mjs",
    "test:color": "node --test scripts/color-management.test.mjs scripts/video-geometry.test.mjs",
    "test:visual-library": "node --test console/jobs.test.mjs scripts/component-registry.test.mjs scripts/visual-preview-lib.test.mjs",
    "test:workflow": "node --test console/runner.test.mjs scripts/workflow-profile.test.mjs scripts/workflow-status.test.mjs scripts/storage-report.test.mjs scripts/music-bed.test.mjs scripts/product-contracts.test.mjs scripts/review-feedback.test.mjs scripts/video-encoder.test.mjs scripts/intake-lib.test.mjs scripts/tag-sdr-rec709.test.mjs scripts/build-windows-bundle.test.mjs scripts/public-release-policy.test.mjs scripts/qa-dialogue-continuity.test.mjs",
    "test:governance": "node --test scripts/lib.test.mjs scripts/governance-lib.test.mjs scripts/ops-git-lib.test.mjs scripts/acceptance.test.mjs scripts/factory-update.test.mjs scripts/migrate-jobs.test.mjs scripts/git-hooks.test.mjs scripts/run-with-beacon.test.mjs scripts/heartbeat.test.mjs scripts/propose.test.mjs scripts/approve-open.test.mjs console/approve.test.mjs",
    "sample": "node scripts/create-sample-job.mjs",
    "transcribe": "node scripts/transcribe-editor.mjs",
    "app": "bash scripts/make-app.sh",
    "build:variants": "node scripts/run-with-beacon.mjs scripts/build-variants.mjs",
    "check:variants": "node scripts/run-with-beacon.mjs scripts/check-variants.mjs",
    "render:variants": "node scripts/run-with-beacon.mjs scripts/render-variants.mjs",
    "qa:variants": "node scripts/run-with-beacon.mjs scripts/qa-variants.mjs",
    "deliver:variants": "node scripts/run-with-beacon.mjs scripts/deliver-variants.mjs",
    "cut:shorts": "node scripts/cut-shorts.mjs",
    "lint": "hyperframes lint",
    "validate": "hyperframes validate",
    "inspect": "hyperframes inspect --samples 20",
    "check": "npm run lint && npm run validate && npm run inspect",
    "render:review": "hyperframes render --fps 30 --quality standard --workers 4 --video-bitrate 24M --output renders/review-30fps.mp4",
    "render:final": "hyperframes render --fps 60 --quality high --workers 8 --video-bitrate 36M --output renders/final-60fps.mp4",
    "qa": "node scripts/qa-final.mjs",
    "qa:final:approve": "node scripts/approve-final-qa.mjs",
    "approve:open": "node scripts/approve-open.mjs",
    "deliver": "node scripts/run-with-beacon.mjs scripts/deliver.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:full": "npm run smoke && cd jobs/smoke && npm run render:final && cd ../.. && npm run qa -- --job jobs/smoke --video jobs/smoke/renders/final-60fps.mp4 && FACTORY_ALLOW_AGENT_APPROVAL=1 npm run deliver -- --job jobs/smoke --video jobs/smoke/renders/final-60fps.mp4",
    "smoke:multi": "node scripts/create-smoke-job.mjs && npm run build:variants -- --job jobs/smoke && npm run check:variants -- --job jobs/smoke",
    "captions:build:legacy-edl": "node scripts/captions-from-edl.mjs",
    "aroll:treat": "node scripts/run-with-beacon.mjs scripts/aroll-treat.mjs",
    "qa:alignment": "node scripts/run-with-beacon.mjs scripts/qa-alignment.mjs",
    "review:independent": "node scripts/run-with-beacon.mjs scripts/review-independent.mjs",
    "test:timing": "node --test scripts/ffmpeg-filter.test.mjs scripts/aroll-treat.test.mjs scripts/whisper-lib.test.mjs scripts/audio-envelope.test.mjs scripts/captions-from-aroll.test.mjs scripts/qa-alignment.test.mjs scripts/review-independent.test.mjs",
    "heartbeat": "node scripts/heartbeat.mjs",
    "propose": "node scripts/propose.mjs"
  },
  "dependencies": {
    "hyperframes": "0.8.14"
  }
}
