{
  "schemaVersion": 1,
  "id": "factory-b2b-leadgen",
  "version": "1.0.1",
  "label": "工厂外贸 B2B 获客全流程",
  "description": "基于多轮真实审片固化的工厂外贸短视频模板：文稿保真快节奏 A-roll、逐词声字同步、移动端大字幕、真实证据 B-roll、克制 Zoom、柔和但清晰的语义音效、联系型 CTA、自然中性美颜与可追溯 QA。",
  "theme": "commerce-pop",
  "compatibleProfiles": ["factory-acquisition"],
  "compatibleLayouts": ["vertical", "horizontal"],
  "requiredWorkflow": {
    "profile": "factory-acquisition",
    "fineCutPreset": "social-fast",
    "editorialMode": "script-preserving-edl",
    "languagePolicy": "preserve-written-script-language-and-case",
    "wordCacheRequired": true,
    "dialogueContinuityQaRequired": true,
    "captionVoiceQaRequired": true
  },
  "caption": {
    "maxCharsPerLine": 22,
    "singleLine": true,
    "placement": "tiktok-safe",
    "fontSize": 66,
    "safeBottom": 550,
    "leftInset": 64,
    "rightInset": 64
  },
  "captionPolicy": {
    "wordsPerCue": [2, 4],
    "alignment": "strict-horizontal-center-same-y-on-aroll-and-broll",
    "case": "preserve-script-case-never-force-uppercase",
    "emphasis": "semantic-keywords-yellow-function-words-white-black-stroke-no-box",
    "punctuation": "remove-terminal-period-comma-keep-question-exclamation-when-semantic",
    "segmentation": "new-clause-new-cue-never-merge-separate-sentences-to-fill-width",
    "timing": "word-cache-lip-sync-no-early-next-cue-no-caption-without-voice",
    "coverage": "every-approved-spoken-word-must-appear-exactly-once",
    "mobileReadability": "66px-default-safe-zone-and-width-gated"
  },
  "editorialPolicy": {
    "opening": "first-frame-overlaps-valid-syllable-mouth-shape-and-speaking-state-within-0.08s-no-inhale-preparation",
    "playbackRate": "prefer-1.1x-for-factory-social-talk-unless-articulation-suffers",
    "takeHeads": "remove-camera-direction-operator-cues-preparation-and-empty-breath",
    "takeTails": "protect-complete-last-word-and-mouth-closure-then-remove-waste",
    "retakeBoundary": "remove-fast-repeated-mistake-even-without-obvious-silence",
    "semanticIntegrity": "never-delete-a-correct-script-word-or-unique-spoken-idea",
    "visualReadiness": "approve-cuts-with-face-expression-frame-stability-waveform-and-word-cache",
    "cutApproval": "semantic-edl-plus-filmstrip-and-waveform-review",
    "operatorCueAudit": "review-every-take-start-for-multilingual-camera-cues",
    "tailMetaSpeechAudit": "remove-recording-only-comments-such-as-done-finished-or-read-complete-after-approved-last-word",
    "audioLeveling": "per-take-local-gain-envelope-or-compressor-before-program-normalization"
  },
  "brollPolicy": {
    "maxCoverage": 0.25,
    "defaultMode": "semantic-full-frame-or-picture-in-picture",
    "proofFirst": true,
    "sourcePriority": ["user-supplied-real-proof", "licensed-1080p-real-proof", "generated-explainer-only-when-real-proof-is-unavailable"],
    "minimumResolution": "1080p",
    "sourceAudio": "always-remove",
    "normalization": "mp4-sdr-bt709-variant-fps-with-30-to-60-frame-blend-when-required",
    "entry": "with-valid-speech-or-after-about-2s-never-mask-untrimmed-silence",
    "continuity": "connect-adjacent-broll-directly-never-flash-aroll-for-less-than-0.5s",
    "transition": "short-semantic-transition-with-one-moderate-sfx",
    "captionSafety": "never-cover-caption-safe-zone-and-keep-identical-caption-y"
  },
  "visualPolicy": {
    "mobileInfoCard": "default-3-by-2-large-canvas-coverage-high-contrast-text-and-background",
    "stickerScale": "phone-first-about-1.5-to-2x-small-desktop-layouts",
    "platformLogo": "respect-speaker-gesture-order-and-position-synchronize-exit-round-corners-without-black-border",
    "semanticAssets": "show-real-product-factory-shop-or-contact-proof-for-key-claims",
    "categoryProductCards": "when-the-script-enumerates-product-categories-show-licensed-or-user-supplied-product-images-as-large-sequential-mobile-cards-matched-to-the-spoken-category",
    "facePriority": true,
    "tiktokSafeArea": true,
    "ctaVariation": "vary-visual-by-product-and-sentence-do-not-reuse-one-identical-large-card"
  },
  "motionPolicy": {
    "faceZoom": {
      "countPerVideo": [3, 4],
      "scale": 1.3,
      "attackFrames": [8, 9],
      "hold": "until-current-semantic-phrase-finishes",
      "releaseFrames": [8, 9],
      "focus": "detected-face-center-with-horizontal-compensation-not-fixed-right",
      "minimumSecondsAfterTransition": 2,
      "noInstantZoom": true
    },
    "entry": "short-pop-rise-or-clean-slide",
    "avoidFlashOnly": true,
    "avoidFragmentedMotion": true,
    "semanticTriggerRequired": true,
    "denseWindow": "when-transition-broll-or-zoom-events-occur-within-2s-use-only-one-priority-sfx"
  },
  "audioPolicy": {
    "openingSfxRequired": true,
    "motionNeedsSfx": true,
    "cardSfx": "soft-rounded-rise-no-slap-no-heavy-impact",
    "transitionSfx": "short-clear-whoosh-lower-than-dialogue",
    "zoomSfx": "subtle-air-only-when-not-near-another-cued-event",
    "brollSfx": "moderate-reveal-cue-without-source-audio",
    "cta": "semantic-mail-phone-or-typing-cue-plus-confirmation-with-speech-priority",
    "cueCollision": "within-2s-keep-only-the-more-important-cue",
    "sfxLevel": "normally-10-to-16db-below-dialogue-adjust-by-ear",
    "musicBed": {
      "required": false,
      "whenEnabled": "energetic-light-epic-funk-or-trending-not-relaxed",
      "tempoBpm": [105, 115],
      "relativeToDialogueDb": [-15, -12],
      "duckUnderSpeech": true,
      "licensedAssetRequired": true
    },
    "mixTarget": {
      "integratedLufs": -13,
      "truePeakDbtp": -1.5,
      "openingVsEarlyDialogueMaxDifferenceDb": 1
    }
  },
  "sfxAssets": {
    "opening": { "asset": "sfx/opening-soft-rise.wav", "volume": 0.42 },
    "card": { "asset": "sfx/card-soft-rise.wav", "volume": 0.48 },
    "transition": { "asset": "sfx/transition-soft-whoosh.wav", "volume": 0.5 },
    "broll": { "asset": "sfx/broll-reveal.wav", "volume": 0.48 },
    "zoom": { "asset": "sfx/zoom-air.wav", "volume": 0.46 },
    "contactTyping": { "asset": "sfx/contact-typing.wav", "volume": 0.54 },
    "contactRing": { "asset": "sfx/contact-ring.wav", "volume": 0.5 },
    "ctaConfirm": { "asset": "sfx/cta-confirm.wav", "volume": 0.46 }
  },
  "colorPolicy": {
    "mode": "per-take-exposure-match-plus-global-look",
    "brightness": "bright-natural-not-dark-yellow",
    "whiteBalance": "consistent-neutral-natural-skin",
    "contrast": "consistent-moderate",
    "beauty": {
      "preset": "factory-neutral-skin-v1",
      "whitening": "subtle",
      "blemishReduction": "subtle",
      "skinSmoothing": "subtle-edge-protected",
      "faceReshape": "off-by-default-opt-in-only",
      "detailRecovery": true,
      "identityPolicy": "non-generative-no-face-reconstruction",
      "qa": "per-take-before-after-filmstrip-plus-final-mp4-sampling"
    }
  },
  "coverPolicy": {
    "required": true,
    "frame": "centered-upright-speaker-frame-or-approved-zoom-frame",
    "hookPlacement": "slightly-above-head-never-cover-face",
    "hookStyle": "centered-red-type-on-solid-yellow-horizontal-rectangle-minimal-shadow",
    "backgroundCleanup": "use-solid-hook-block-to-cover-distracting-signage-when-needed",
    "secondaryText": "centered-mobile-readable-high-contrast",
    "firstFrame": true
  },
  "outroPolicy": {
    "trigger": "contact-quote-dm-email-phone-or-write-to-us",
    "visual": "product-semantic-broll-plus-mail-phone-or-typing-sticker-group",
    "audio": "typing-phone-or-soft-ring-plus-confirmation",
    "priority": "stronger-than-body-cues-but-comfortable-and-dialogue-safe"
  },
  "outputPolicy": {
    "container": "mp4",
    "masterFirst": true,
    "frameRate": "variant-owned-default-60fps-never-silently-drop-to-30fps",
    "frameRateAudit": "record-60000-over-1001-versus-60-over-1-explicitly",
    "color": "sdr-bt709-yuv420p",
    "audio": "48khz-aac",
    "platformDerivatives": "derive-from-high-quality-master"
  },
  "qaPolicy": {
    "required": [
      "written-script-word-coverage",
      "every-caption-has-corresponding-voice",
      "every-approved-spoken-word-has-caption",
      "operator-cue-audit-at-every-take-start",
      "visual-ready-opening-no-inhale-or-gesture-preparation",
      "recording-only-tail-meta-speech-removed",
      "enumerated-product-categories-have-semantic-large-card-coverage-when-assets-are-available",
      "first-syllable-and-last-word-protection",
      "filmstrip-waveform-and-face-readiness-at-every-cut",
      "no-short-aroll-flash-between-broll",
      "same-caption-y-on-aroll-and-broll",
      "opening-and-adjacent-dialogue-level-check",
      "sfx-collision-and-dialogue-priority-check",
      "final-mp4-full-decode-frame-sampling-audio-and-color-qa"
    ]
  },
  "components": [
    "media-pop-sticker",
    "product-domain-pop",
    "ui-click-sticker",
    "keyword-burst",
    "hook-stack-banner",
    "cta-badge"
  ],
  "assets": [
    "sfx/opening-soft-rise.wav",
    "sfx/card-soft-rise.wav",
    "sfx/transition-soft-whoosh.wav",
    "sfx/broll-reveal.wav",
    "sfx/zoom-air.wav",
    "sfx/contact-typing.wav",
    "sfx/contact-ring.wav",
    "sfx/cta-confirm.wav",
    "stickers/contact-mail.svg",
    "stickers/contact-phone.svg"
  ]
}
