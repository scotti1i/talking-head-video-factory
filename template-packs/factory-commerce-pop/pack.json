{
  "schemaVersion": 1,
  "id": "factory-commerce-pop",
  "version": "2.1.0",
  "label": "工厂电商弹贴",
  "description": "面向工厂外贸网站与产品口播的高留存模板：无框黄字重点、域名纸条、悬念 Web 贴纸、大产品图、简约 CTA、语义节点音效和自然统一调色。",
  "theme": "commerce-pop",
  "compatibleProfiles": ["factory-acquisition"],
  "compatibleLayouts": ["vertical", "horizontal"],
  "caption": {
    "maxCharsPerLine": 22,
    "singleLine": true,
    "placement": "tiktok-safe",
    "fontSize": 64,
    "safeBottom": 550,
    "leftInset": 64,
    "rightInset": 64
  },
  "brollPolicy": {
    "maxCoverage": 0.25
  },
  "components": [
    "product-domain-pop",
    "ui-click-sticker"
  ],
  "assets": [
    "sfx/pop-soft.wav",
    "sfx/final-ding.wav",
    "sfx/click-confirm.wav",
    "sfx/follow-confirm.wav",
    "stickers/web-globe-teaser.svg"
  ]
}
