{
  "schemaVersion": 1,
  "default": "standard",
  "profileDefaults": {
    "factory-acquisition": "social-fast"
  },
  "presets": {
    "natural": {
      "label": "自然",
      "description": "保留更多呼吸、表情和手势准备，不追求最大切点密度。",
      "breathSeconds": {
        "min": 0.28,
        "max": 0.45
      },
      "allowSentenceReorder": false,
      "allowUniqueScriptDeletion": false
    },
    "standard": {
      "label": "标准",
      "description": "删除口误、失败重拍和拖沓等待，同时保留自然连读与完整手势。",
      "breathSeconds": {
        "min": 0.18,
        "max": 0.35
      },
      "allowSentenceReorder": false,
      "allowUniqueScriptDeletion": false
    },
    "tight": {
      "label": "紧凑",
      "description": "适合广告投放的更快节奏，但仍不得截断单词或删除原稿独有信息。",
      "breathSeconds": {
        "min": 0.12,
        "max": 0.24
      },
      "allowSentenceReorder": false,
      "allowUniqueScriptDeletion": false
    },
    "social-fast": {
      "label": "社媒快节奏",
      "description": "TikTok、Instagram 等前三秒获客口播：尽快进入有效发声，除明确留白和转场缓冲外不保留可感知气口。",
      "breathSeconds": {
        "min": 0.06,
        "max": 0.18
      },
      "transitionBufferSeconds": {
        "min": 0.1,
        "max": 0.3
      },
      "playbackRate": 1.1,
      "maxOpeningSilenceSeconds": 0.08,
      "maxTakeLeadInSeconds": 0.08,
      "openingVisualReadiness": "first-frame-must-overlap-valid-syllable-mouth-shape-and-speaking-state-no-inhale-preparation",
      "protectedTailSeconds": {
        "min": 0.08,
        "max": 0.25
      },
      "maxAdjacentSpeechWindowJumpDb": 4,
      "operatorCuePolicy": "reject-at-every-take-start",
      "wrapMetaSpeechPolicy": "reject-recording-directions-and-completion-comments-at-every-take-tail",
      "allowSentenceReorder": false,
      "allowUniqueScriptDeletion": false
    }
  }
}
