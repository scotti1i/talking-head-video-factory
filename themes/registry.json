      "activeColor": "#12DDEB",
      "outlineColor": "#050505",
      "shadowColor": "rgba(0, 0, 0, 0.78)",
      "fontSizePortrait": 104,
      "fontSizeLandscape": 72,
      "maxWidthRatioPortrait": 0.76,
      "maxWidthRatioLandscape": 0.34
    }
