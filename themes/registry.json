{
  "default": "warm-glass",
  "themes": ["warm-glass", "warm-minimal", "pastel-ledger", "field-notes", "signal-yellow", "steel-blueprint", "neon-forest", "editorial-stage", "trade-proof", "sample-replica", "market-proof"],
  "captionPresets": {
